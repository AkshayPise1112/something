# T→G (Trend to Growth) Environment Configuration

APP_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Gemini AI (Reasoning Layer)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# External Trend Connectors
YOUTUBE_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendToGrowthBot/1.0

GOOGLE_TRENDS_PROVIDER=mock
GOOGLE_TRENDS_API_KEY=

# Supabase / PostgreSQL Database configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgotg
DIRECT_DATABASE_URL=

# Authentication
AUTH_MODE=demo
JWT_SECRET=tg-secret-jwt-key-growth-works-2025

# Storage
STORAGE_MODE=local
STORAGE_BASE_PATH=./storage

# Operational Modes
DATA_MODE=demo
DEMO_MODE=true
INTELLIGENCE_MODE=mock

# Local AI runtime (when INTELLIGENCE_MODE=local)
AI_RUNTIME=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.1:8b
AI_VERSION=8b-instruct

# Embeddings & Reranking (Local/Open models)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=bge-reranker-base

# Future T→G Dedicated Model (when INTELLIGENCE_MODE=tgo)
TGO_AI_BASE_URL=
TGO_AI_API_KEY=
TGO_AI_MODEL=tgo-growth-8b
TGO_AI_VERSION=tgo-v1

LOG_LEVEL=info
